# AgentPoison environment configuration
# -------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# All scripts load it automatically via python-dotenv if installed.

# --- DeepSeek (backbone cho ReAct / EhrAgent; endpoint tương thích OpenAI) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# Code trong repo dùng SDK `openai` và đọc biến OPENAI_*, nên trỏ thẳng sang
# DeepSeek. Muốn quay lại OpenAI thì thay bằng key sk-... và bỏ trống BASE_URL.
OPENAI_API_KEY=${DEEPSEEK_API_KEY}
OPENAI_BASE_URL=${DEEPSEEK_BASE_URL}
OPENAI_ORG=
# Fine-tune planner cho Agent-Driver: DeepSeek không có fine-tuning API, phần này
# vẫn cần một model đã fine-tune trên OpenAI.
FINETUNE_PLANNER_NAME=

# --- Replicate (LLaMA-3-70b API backbone for ReAct / EHRAgent) ---
REPLICATE_API_TOKEN=

# --- SerpAPI (only needed for live web search in ReAct) ---
SERPAPI_API_KEY=

# --- Local model / checkpoint paths (optional overrides) ---
# Path or HF id of the white-box target LLM used for target-gradient guidance.
LLAMA2_CHAT_7B_PATH=meta-llama/Llama-2-7b-chat-hf
# Directory holding the fine-tuned RAG embedder checkpoints (contrastive / classification).
EMBEDDER_CKPT_DIR=RAG/embedder
# Repo root used by some standalone utility scripts; defaults to the current directory.
AGENTPOISON_ROOT=.
# nuScenes dataset root (only needed for the Agent-Driver visualization script).
NUSCENES_DATAROOT=dataset/v1.0-mini

# --- Braintrust (tracing từng bước của agent; bỏ trống = tắt tracing) ---
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=ADAPT-EhrAgent
# Cắt bớt chuỗi dài (prompt/code) trước khi gửi lên Braintrust.
BRAINTRUST_MAX_CHARS=8000
